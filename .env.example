# Copy to apps/web/.env.local and apps/admin/.env.local for local dev
DATABASE_URL=postgresql://vocalink:vocalink@localhost:5432/vocalink
BETTER_AUTH_SECRET=change-me-to-32-chars-minimum-local-only
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudflare R2 (S3-compatible) — OPTIONAL for now. Leave empty = free local ./uploads/ mode.
# Add later to upgrade with zero code changes.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=vocalink-portfolios
R2_PRIVATE_BUCKET=vocalink-private
R2_PUBLIC_URL=

# Free local uploads (used when R2 vars are empty)
LOCAL_UPLOADS_DIR=

# Email (local Mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
